{
  "uid": "homelab-overview",
  "title": "Homelab 개요",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "tags": ["homelab"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "발화 중 경보(Watchdog 제외)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "tailnet 마지막 질의 뒤 경과(로그 기준)",
      "description": "AdGuard 질의 로그에서 가장 새 항목과 지금 svclb 파드 IP 출처 마지막 항목의 차이. 3600초를 넘으면 AdGuardTailnetQueriesMissing.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "max(adguard_querylog_last_query_timestamp_seconds) - max(max by (client) (adguard_querylog_last_query_timestamp_seconds) * on (client) group_left () max by (client) (label_replace(kube_pod_info{namespace=\"kube-system\", created_by_kind=\"DaemonSet\", created_by_name=~\"svclb-adguard-dns-.+\"}, \"client\", \"$1\", \"pod_ip\", \"(.+)\")))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1800 }, { "color": "red", "value": 3600 }] } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "수집 대상 down",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "count(up == 0) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Telegram 전송 실패(1시간)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(increase(alertmanager_notifications_failed_total{integration=\"telegram\"}[1h])) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "노드 메모리 사용률(MemAvailable 기준)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "파일시스템 여유",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "node_filesystem_avail_bytes{fstype=~\"ext4|xfs|btrfs\"} / node_filesystem_size_bytes{fstype=~\"ext4|xfs|btrfs\"}", "legendFormat": "{{mountpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "컨테이너 메모리(working set) / limit",
      "description": "limit 여유 산정용. OOM 결합 루프(vector·VictoriaLogs)를 볼 때 쓴다.",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "max by (namespace, pod, container) (container_memory_working_set_bytes) / on (namespace, pod, container) group_left () max by (namespace, pod, container) (kube_pod_container_resource_limits{resource=\"memory\"})", "legendFormat": "{{namespace}}/{{container}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "컨테이너 재시작(1시간)",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[1h])) > 0", "legendFormat": "{{namespace}}/{{pod}}" }],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    }
  ]
}
