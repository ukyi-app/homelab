{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["tailscale"],
  "properties": {
    "tailscale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix"],
      "properties": {
        "prefix": {
          "type": "string",
          "maxLength": 56,
          "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?-)?$"
        }
      }
    }
  }
}
