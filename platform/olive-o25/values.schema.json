{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["hc", "restartRule", "body", "claude", "control", "bodyLimits"],
  "definitions": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuLimit", "memoryLimit"],
      "properties": {
        "cpuLimit": { "type": "string", "pattern": "^[0-9]+m$" },
        "memoryLimit": { "type": "string", "pattern": "^[0-9]+Mi$" }
      }
    }
  },
  "properties": {
    "hc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "url": {
          "type": "string",
          "pattern": "^https://releases\\.herdr\\.dev/core/[0-9]+\\.[0-9]+\\.[0-9]+/herdr-core-linux-x86_64\\.tar\\.gz$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "restartRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "exitCode"],
      "properties": {
        "enabled": { "type": "boolean" },
        "exitCode": { "type": "integer", "minimum": 64, "maximum": 113 }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "command"],
      "properties": {
        "variant": { "type": "string", "enum": ["shell", "claude"] },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "sha256", "size", "memoryLimit"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "url": {
          "type": "string",
          "pattern": "^https://downloads\\.claude\\.ai/claude-code-releases/[0-9]+\\.[0-9]+\\.[0-9]+/linux-x64-musl/claude$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 400000000 },
        "memoryLimit": { "type": "string", "pattern": "^[0-9]+Mi$" }
      }
    },
    "control": { "$ref": "#/definitions/limits" },
    "bodyLimits": { "$ref": "#/definitions/limits" }
  }
}
