{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "probe", "kubernetesApi"],
  "properties": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "app", "workerPort", "alertPort"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^(bot-slot-probe|app-[a-z0-9]([a-z0-9-]{0,51}[a-z0-9])?)$" },
        "app": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,51}[a-z0-9])?$" },
        "workerPort": { "const": 8080 },
        "alertPort": { "type": "integer", "minimum": 1024, "maximum": 65535, "not": { "const": 8080 } }
      }
    },
    "probe": { "type": "boolean" },
    "kubernetesApi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpointCIDRs"],
      "properties": {
        "endpointCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/32$",
            "not": { "pattern": "^(0|127)\\.|^10\\.4[23]\\." }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "probe": { "const": true } } },
      "then": { "properties": { "target": { "properties": { "namespace": { "const": "bot-slot-probe" } } } } }
    },
    {
      "if": { "properties": { "target": { "properties": { "namespace": { "const": "bot-slot-probe" } } } } },
      "then": { "properties": { "probe": { "const": true } } }
    }
  ]
}
