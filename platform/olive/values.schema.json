{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" } }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" } }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "mountPath"],
      "properties": {
        "secretName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
          "not": { "pattern": "^(olive-signing-key$|olive-account-)" }
        },
        "mountPath": { "type": "string", "pattern": "^/run/" }
      }
    },
    "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
    "hours": { "type": "integer", "minimum": 1 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["infisical", "image", "supervisor", "pki", "executors", "externalSecrets"],
  "if": {
    "required": ["pki"],
    "properties": { "pki": { "required": ["enabled"], "properties": { "enabled": { "const": true } } } }
  },
  "then": {
    "properties": {
      "supervisor": { "properties": { "tls": { "properties": { "secretName": { "const": "" } } } } },
      "executors": {
        "additionalProperties": { "properties": { "tls": { "properties": { "secretName": { "const": "" } } } } }
      }
    }
  },
  "properties": {
    "infisical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectSlug", "environmentSlug"],
      "properties": { "projectSlug": { "type": "string" }, "environmentSlug": { "type": "string" } }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "const": "ghcr.io/ukyi-app/olive" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" }
      }
    },
    "supervisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "clusterIP", "resources", "ledger", "signingKey", "account", "extraClientNamespaces", "tls"],
      "properties": {
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "clusterIP": {
          "type": "string",
          "pattern": "^10\\.43\\.0\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$",
          "not": { "enum": ["10.43.0.0", "10.43.0.1", "10.43.0.10", "10.43.0.28"] }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storageClassName", "size", "mountPath"],
          "properties": {
            "storageClassName": { "const": "local-retain" },
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" },
            "mountPath": { "type": "string", "pattern": "^/var/lib/" }
          }
        },
        "signingKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "publicKeyPem"],
          "properties": {
            "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "publicKeyPem": {
              "type": "string",
              "pattern": "^(-----BEGIN PUBLIC KEY-----\\n[\\s\\S]*-----END PUBLIC KEY-----\\n?)?$",
              "not": { "pattern": "PRIVATE KEY" }
            }
          }
        },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?)?$" },
            "key": { "const": "CLAUDE_CODE_OAUTH_TOKEN" }
          }
        },
        "extraClientNamespaces": { "type": "array", "items": { "$ref": "#/definitions/namespace" } },
        "tls": { "$ref": "#/definitions/tls" }
      }
    },
    "pki": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ca", "leaf", "trustBundlePem"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ca": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generations", "activeGeneration", "durationHours", "renewBeforeHours"],
          "properties": {
            "generations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1 }
            },
            "activeGeneration": { "type": "integer", "minimum": 1 },
            "durationHours": { "$ref": "#/definitions/hours" },
            "renewBeforeHours": { "$ref": "#/definitions/hours" }
          }
        },
        "leaf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationHours", "renewBeforeHours"],
          "properties": {
            "durationHours": { "$ref": "#/definitions/hours" },
            "renewBeforeHours": { "$ref": "#/definitions/hours" }
          }
        },
        "trustBundlePem": {
          "type": "string",
          "pattern": "^(-----BEGIN CERTIFICATE-----\\n[\\s\\S]*-----END CERTIFICATE-----\\n?)?$",
          "not": { "pattern": "PRIVATE KEY" }
        }
      }
    },
    "executors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resources", "tls"],
        "properties": {
          "resources": { "$ref": "#/definitions/resources" },
          "tls": { "$ref": "#/definitions/tls" }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
