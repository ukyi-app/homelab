{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
      "not": {
        "allOf": [
          { "pattern": "(^|\\.)github\\.com$" },
          { "not": { "const": "codeload.github.com" } }
        ]
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["infisical", "proxy", "worker", "task"],
  "if": {
    "properties": { "task": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] } },
    "required": ["task"]
  },
  "then": {
    "properties": {
      "worker": { "properties": { "profile": { "properties": { "id": { "const": "claude-subscription" } } } } },
      "task": { "properties": { "nodeName": { "minLength": 1 } } }
    }
  },
  "properties": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "replicas", "remoteCredentialKey", "remoteApiKey", "nodeName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "pattern": "^ghcr\\.io/ukyi-app/homelab-bot@sha256:[0-9a-f]{64}$" },
        "replicas": { "type": "integer", "enum": [0, 1] },
        "remoteCredentialKey": { "const": "CLAUDE_CODE_OAUTH_TOKEN_TASK" },
        "remoteApiKey": { "const": "ANTHROPIC_API_KEY_TASK" },
        "nodeName": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas", "controlPublicKey", "profile"],
      "properties": {
        "image": { "type": "string", "pattern": "^ghcr\\.io/ukyi-app/homelab-bot@sha256:[0-9a-f]{64}$" },
        "replicas": { "type": "integer", "enum": [0, 1] },
        "controlPublicKey": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----\\nMCowBQYDK2VwAyEA[A-Za-z0-9+/]{43}=\\n-----END PUBLIC KEY-----\\n?$"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "executor", "model", "credentialKey", "egressHosts"],
          "properties": {
            "id": { "type": "string" },
            "executor": { "type": "string" },
            "model": { "type": "string" },
            "credentialKey": { "type": "string" },
            "methods": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["marker", "apiKey"],
              "properties": {
                "marker": { "type": "string" },
                "apiKey": { "type": "string" }
              }
            },
            "egressHosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/host" } }
          },
          "oneOf": [
            {
              "required": ["methods"],
              "properties": {
                "id": { "const": "claude-subscription" },
                "executor": { "const": "claude" },
                "credentialKey": { "const": "CLAUDE_CODE_OAUTH_TOKEN" },
                "methods": {
                  "type": "object",
                  "properties": { "marker": { "const": "CLAUDE_AUTH_METHOD" }, "apiKey": { "const": "ANTHROPIC_API_KEY" } }
                },
                "model": { "pattern": "^claude-[a-z0-9]+(-[a-z0-9]+){1,8}$" }
              }
            },
            {
              "properties": {
                "id": { "const": "codex-subscription" },
                "executor": { "const": "codex" },
                "credentialKey": { "const": "CODEX_AUTH_JSON" },
                "methods": { "type": "null" },
                "model": { "const": "cli-default" }
              }
            }
          ]
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "infisical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectSlug", "environmentSlug"],
      "properties": {
        "projectSlug": { "type": "string" },
        "environmentSlug": { "type": "string" }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterIP", "port", "allowedDomains"],
      "properties": {
        "clusterIP": {
          "type": "string",
          "pattern": "^10\\.43\\.0\\.([2-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-4])$",
          "not": { "const": "10.43.0.10" }
        },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "allowedDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/host" }
        }
      }
    }
  }
}
