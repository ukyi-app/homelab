# 클러스터 공통 호스트 값. host/*.sh가 source한다(직접 실행하지 않는다).
# 클러스터마다 다른 값은 host/clusters/<이름>.env에 둔다.
#
# 이 파일은 재구축 목표값이다. 버전을 올리는 PR을 병합해도 라이브 k3s는 바뀌지 않는다.
# 업그레이드는 사람이 sudo host/install.sh --cluster <이름> --k3s를 다시 실행하는 작업이고,
# Renovate PR은 그 입력일 뿐이다(B.8 E2, 옛 versions.env:5-9).

# k3s 버전. 채널(stable/latest)로 설치하지 않는다. 같은 입력이면 같은 클러스터가 나와야 한다.
# install.sh는 이 태그의 설치 스크립트를 받아 이 버전으로 설치하고, verify.sh는 라이브 kubelet
# 버전과 대조한다.
INSTALL_K3S_VERSION="v1.36.5+k3s1"

# 노드 타임존. CronJob은 노드 TZ를 따르므로 틀리면 일정이 9시간 밀린다. CNPG ScheduledBackup은
# operator TZ(UTC)를 따르므로 백업 일정은 UTC로 적는다. Ubuntu 26.04에는 /etc/timezone이 없다.
# 진실원은 /etc/localtime 심링크이고 timedatectl로만 바꾼다.
TIMEZONE="Asia/Seoul"

# 노드 자신의 업스트림 DNS(공백 구분, 앞이 1순위). 클러스터 안(AdGuard)이나 공유기를 가리키면
# 콜드스타트 교착이 돌아온다. host/etc/systemd/resolved.conf.d/10-k3s-node.conf의 DNS= 줄과
# 같아야 하고, install.sh가 복사 전에 대조한다.
NODE_UPSTREAM_DNS="1.1.1.1 9.9.9.9"
