# 시나리오 13 검증 VM 클러스터(vm)의 호스트 값. host/*.sh --cluster vm이 source한다.
# prod.env와 키가 같다. VM은 NUC 안의 임시 KVM VM이고 libvirt NAT 뒤에 있다(사용자·lead 2026-10-26).
# 아래 세 값은 docs/runbooks-public/vm.md 1절이 만드는 VM과 짝이다. 한쪽만 바꾸면 preflight가 멈춘다.

# vm- 접두로 정한다. 운영 노드 이름과 겹치면 파괴 명령 전 노드 이름 확인이 두 클러스터를 가르지 못한다.
NODE_NAME="vm-node"

# VM의 NAT 주소. libvirt 네트워크 homelab-vm의 DHCP 예약(MAC 52:54:00:13:00:10)이 고정한다.
# k3s의 node-ip·TLS SAN은 설치 때만 정해지므로 예약 없이 주소가 바뀌면 k3s가 뜨지 못한다.
# 192.168.122.0/24는 libvirt 기본 NAT 대역이라 LAN·tailnet 주소를 드러내지 않는다(D-23). NUC에서만 닿는다.
NODE_IP="192.168.122.10"

# q35 + virtio NIC에서 클라우드 이미지가 주는 이름. vm.md의 cloud-init network-config가 MAC으로 이 이름을
# 고정한다. netplan ID가 곧 10-netplan-<iface>.network 이름이라 networkd drop-in 경로가 여기에 묶인다.
NODE_IFACE="enp1s0"

# VM 호스트는 tailnet에 넣지 않는다(D-12, E8 VM 격리 4번). 사람 기기로 등록되면 운영자 ACL로
# VM에서 운영 NUC의 SSH·kubectl 포트에, self 규칙으로 사람 기기 전체에 닿는다.
# false면 host 스크립트가 Tailscale 단계와 SAN의 MagicDNS 이름을 건너뛰고, VM이 tailnet에
# 들어가 있으면 멈춘다.
TAILNET_JOIN="false"

# Tailscale 기기 이름. VM은 tailnet 밖이라 쓰지 않는다. 비우면 NODE_NAME(prod.env 주석).
TAILNET_DEVICE_NAME=""

# kubeconfig context 각인(E8 VM 격리 6번).
KUBE_CONTEXT="homelab-vm"

# 파드·서비스 대역. k3s 기본값이고 운영과 같다(prod.env 주석). VM LAN이 10.0.0.0/8이어도 이 둘과
# 겹치면 안 된다. install.sh --egress가 NODE_IP가 이 대역 안이면 멈춘다.
POD_CIDR="10.42.0.0/16"
SERVICE_CIDR="10.43.0.0/16"
