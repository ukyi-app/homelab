# 시나리오 13 검증 VM 클러스터(vm)의 호스트 값. host/*.sh --cluster vm이 source한다.
# prod.env와 키가 같다. CHANGE_ME는 자리표시이고, T13에서 VM을 준비할 때 그 VM 값으로 채운다.
# 자리표시가 남아 있으면 host 스크립트가 아무것도 바꾸지 않고 멈춘다.

# vm- 접두로 정한다(예: vm-node). 운영 노드 이름과 겹치면 파괴 명령 전 노드 이름 확인이
# 두 클러스터를 가르지 못한다.
NODE_NAME="vm-CHANGE_ME"

# VM의 LAN IPv4. TLS SAN에 들어가고, VM 접근은 이 주소나 콘솔로 한다.
NODE_IP="CHANGE_ME"

# NODE_IP가 붙은 VM 인터페이스 이름.
NODE_IFACE="CHANGE_ME"

# VM 호스트는 tailnet에 넣지 않는다(D-12, E8 VM 격리 4번). 사람 기기로 등록되면 ACL의
# autogroup:self 규칙으로 VM에서 운영 NUC의 모든 포트와 Tailscale SSH root에 닿는다.
# false면 host 스크립트가 Tailscale 단계와 SAN의 MagicDNS 이름을 건너뛰고, VM이 tailnet에
# 들어가 있으면 멈춘다.
TAILNET_JOIN="false"

# kubeconfig context 각인(E8 VM 격리 6번).
KUBE_CONTEXT="homelab-vm"
