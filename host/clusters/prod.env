# 운영 NUC 클러스터(prod)의 호스트 값. host/*.sh --cluster prod가 source한다.
# vm.env와 키가 같아야 한다. 스크립트는 클러스터 이름으로 분기하지 않고 이 값만 읽는다.
#
# 이 저장소는 공개다. MagicDNS 전체 이름과 tailnet 이름, Tailscale IP는 여기 두지 않는다.
# install.sh와 verify.sh가 실행 때 tailscale status로 얻는다.

# k8s 노드 이름. k3s 설치 때만 정할 수 있고, 바꾸면 노드가 새로 등록돼 hostPath PV의
# nodeAffinity가 깨진다.
NODE_NAME="nuc-15-pro"

# Tailscale 기기 이름(MagicDNS 이름의 첫 라벨만. 뒤의 tailnet 도메인은 두지 않는다). 비우면 NODE_NAME.
# install.sh·verify.sh가 실제 첫 라벨과 대조해, 옛 기기가 남아 -1이 붙은 재등록을 잡는다.
# 2026-10-26 사용자가 콘솔에서 nuc-pro로 바꿨다(NODE_NAME·호스트 이름은 그대로). 이름을 바꾸면 MagicDNS
# 이름도 바뀐다. 옛 이름은 더 풀리지 않고, k3s 인증서 SAN에는 설치 때의 MagicDNS 이름만 있다.
TAILNET_DEVICE_NAME="nuc-pro"

# 노드 LAN IPv4. 설치 때만 정할 수 있다. 공유기 DHCP 예약이 전제이고, 예약은 사람이 확인한다.
# 예약 없이 임대가 바뀌면 k3s가 이 주소로 뜨지 못한다.
NODE_IP="192.168.117.15"

# NODE_IP가 붙은 인터페이스. networkd drop-in 경로(10-netplan-<iface>.network.d)가 이 값을 쓴다.
# 유선으로 옮기면 이 값과 공유기 예약을 함께 바꾼다.
NODE_IFACE="wlo1"

# true면 Tailscale 단계(accept-dns=false)를 하고 TLS SAN에 MagicDNS 이름을 넣는다.
TAILNET_JOIN="true"

# kubeconfig의 context·cluster·user 이름. 두 클러스터가 공존할 때 반대편을 조작하지 않게
# 클러스터를 이름에 각인한다(B.8 E2). install.sh가 ~/.kube/<이 값>.yaml로 쓴다.
KUBE_CONTEXT="homelab"

# 파드·서비스 대역. k3s 기본값(cluster-cidr, service-cidr)이고 host/k3s-config.yaml은 바꾸지 않는다.
# 파드 egress 규칙(install.sh --egress)이 이 값으로 파드 출발을 고르고 클러스터 안 통신을 허용한다.
# 라이브 대역과 다르면 규칙이 아무 파드에도 걸리지 않으므로 verify.sh가 라이브 podCIDR·Service IP와 대조한다.
POD_CIDR="10.42.0.0/16"
SERVICE_CIDR="10.43.0.0/16"
