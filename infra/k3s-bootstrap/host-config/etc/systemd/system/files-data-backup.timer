# files-data 백업 스케줄 — RPO=24h (r4의 FilesBackupStale 임계 180000s=2.08일과 짝).
# ⚠️ enable은 국면 B 이후다. 짝 유닛 `files-data-backup.service`의 머리말이 이유를 담는다.
[Unit]
Description=files-data 오프-매체 백업 (일 1회)

[Timer]
OnCalendar=daily
# 부팅 직후 몰림·다른 일일 잡과의 충돌을 흩는다. RPO 24h 대비 무시할 수 있는 폭이다.
RandomizedDelaySec=30min
# 노드가 꺼져 있어 놓친 슬롯은 다음 부팅에 한 번 따라잡는다 — 그렇지 않으면 재부팅이
# 곧 RPO 구멍이 되고, FilesBackupStale이 그 구멍을 뒤늦게 알린다.
Persistent=true

[Install]
WantedBy=timers.target
