#!/usr/bin/env bash
# 호스트 기반 계층이 쓰는 외부 유래 버전 전부의 SSOT.
# install/storage 스크립트와 CI 체크가 source 한다 (직접 실행은 절대 안 함).

# k3s 릴리스 채널 태그 (고정 — 'stable'/'latest' 금지, cattle 재구축이 결정적이도록).
export K3S_VERSION="v1.36.2+k3s1"

# 게스트 OS.
export DEBIAN_RELEASE="bookworm"            # Debian 12, arm64
export DEBIAN_ARCH="arm64"

# rancher/local-path-provisioner 차트/앱 버전 (Task 1.7에서 매니페스트를 벤더링한다).
export LOCAL_PATH_PROVISIONER_VERSION="v0.0.36"

# HelperPod 이미지 — local-path가 노드에서 PV 디렉토리 mkdir/rm 에 사용한다.
# 불변 digest로 고정해 재현 가능하게 한다(떠다니는 태그는 cattle 재구축을 깨뜨린다).
# ⚠️ 이 자리에 "arm64 digest로 고정해 amd64를 조용히 끌어오는 일이 없게 한다"고 적혀 있었으나 **거짓**이었다:
#    이 digest는 amd64를 포함한 9플랫폼 인덱스다(실측 2026-08-11 — amd64·arm64·arm/v5·v6·v7·386·
#    ppc64le·riscv64·s390x). 노드 아키텍처를 따라가는 것이 맞고, NUC(amd64) 이전에 필요한 성질이다.
#    arch를 실제로 고정하려면 자식 manifest digest를 써야 하는데 그럴 이유가 없다.
export LOCAL_PATH_HELPER_IMAGE="busybox:1.38@sha256:fd8d9aa63ba2f0982b5304e1ee8d3b90a210bc1ffb5314d980eb6962f1a9715d"

# VM 사이징 (R3 + 메모리 예산 §10): 상한 12 GiB, 6 vCPU, 머신 하나.
# ⚠️ 호스트 Mac RAM 16 GiB — 12 GiB 할당은 macOS에 4 GiB만 남겨 타이트하다(2026-07-08 `orb start`가
#    한 번 타임아웃 후 정상 기동). 부하 시 스왑 주의. 원장 meta VM_ALLOCATABLE_MIB와 동반 관리(메타갭 ⑥ F23).
export ORB_MEMORY_MIB="12288"               # 12 GiB
export ORB_CPU="6"

# ── NUC 베어메탈 호스트 좌표 (owner 확정 D-a/D-b) ──────────────────────────────────────────
# 노드 InternalIP. `wlo1`(WiFi)의 **DHCP 예약** 주소다.
# ⚠️ 라우터에 MAC `d4:94:a9:26:95:3a` 예약이 걸려 있어야 한다. 예약 없이 임대가 바뀌면 k3s가 이 주소를
#    못 잡아 **기동에 실패한다** — 조용히 다른 IP로 표류하는 것보다 낫다. netpol의 노드 서브넷 allow
#    6곳이 이 값의 /24를 전제하므로(platform/**), 표류하면 워크로드가 apiserver를 잃는다.
# ⚠️ 유선 `enp86s0`은 현재 NO-CARRIER다. 케이블을 꽂으면 기본 경로가 바뀔 수 있는데, 이 핀이 있으면
#    노드 IP는 움직이지 않는다(= 커밋 없이 발생하는 회귀 경로를 이 한 줄이 막는다).
export K3S_NODE_IP="192.168.117.15"

# apiserver serving cert의 **추가** SAN(공백 구분). k3s가 기본으로 넣는 것(127.0.0.1 · localhost ·
# 노드 hostname · kubernetes.default.svc …)에 더해진다.
# ⚠️ **설치 시점에만 정할 수 있다** — 사후 추가는 serving cert 삭제 후 재생성을 요구한다.
# ⚠️ tailnet 이름 `homelab`을 여기 넣지 않는다. 그건 이 노드가 아니라 tailscale operator가 만드는
#    **traefik-ts 프록시 디바이스**의 이름이다(platform/tailscale/prod/traefik-ingress.yaml:12,
#    라이브 100.120.85.39). 이 노드의 tailnet 이름은 `nuc-15-pro`다.
#    (리눅스 hostname이 `homelab`이라 k3s가 그걸 자동으로 SAN에 넣는 것과는 별개다.)
export K3S_TLS_SANS="192.168.117.15 100.109.208.81 nuc-15-pro nuc-15-pro.tailcf1ac6.ts.net"

# 노드 로컬 스토리지 경로.
# internal: VM 자체 디스크 위, cloud-init이 생성 (Task 1.4).
export INTERNAL_STORAGE_PATH="/var/lib/rancher/k3s-storage/internal"   # 내장 SSD(VM /dev/vdb1, btrfs ~224GiB 실측)
# bulk: 외장 SSD 위, OrbStack이 virtiofs 마운트로 VM에 공유한다. 외장 'homelab' APFS
# 볼륨과 이 디렉토리는 docs/runbooks/external-ssd.md 에 따라 프로비저닝되고
# apply-storage.sh의 외장 SSD 게이트(Pass-5 Open Item #1)가 강제하므로, SSD가 없거나
# 쓰기 불가하면 bulk가 VM 디스크에 조용히 놓이는 대신(cattle 재구축 시 유실) 요란하게 실패한다.
export BULK_EXTERNAL_HOST_PATH="/Volumes/homelab"                     # 외장 SSD의 macOS 마운트 (호스트 측 diskutil 검사)
export BULK_EXTERNAL_MOUNT="/mnt/mac${BULK_EXTERNAL_HOST_PATH}"        # 같은 볼륨의 VM 내부 시점 (OrbStack virtiofs)
export BULK_STORAGE_PATH="${BULK_EXTERNAL_MOUNT}/k3s-bulk"             # bulk-ssd 노드 경로 (VM 내부)
# dev/이너루프 폴백, apply-storage.sh가 BULK_ALLOW_VM_DISK=1 로 실행될 때만 사용.
# bulk를 VM 디스크에 놓는다(재구축 시 비영속) — 실데이터에는 절대 금지.
export BULK_VM_DISK_FALLBACK="/var/lib/rancher/k3s-storage/bulk"
