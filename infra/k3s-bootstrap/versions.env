#!/usr/bin/env bash
# 호스트 기반 계층이 쓰는 외부 유래 버전 전부의 SSOT.
# install/storage 스크립트와 CI 체크가 source 한다 (직접 실행은 절대 안 함).

# k3s 릴리스 채널 태그 (고정 — 'stable'/'latest' 금지, cattle 재구축이 결정적이도록).
export K3S_VERSION="v1.36.2+k3s1"

# rancher/local-path-provisioner 차트/앱 버전 (Task 1.7에서 매니페스트를 벤더링한다).
export LOCAL_PATH_PROVISIONER_VERSION="v0.0.36"

# HelperPod 이미지 — local-path가 노드에서 PV 디렉토리 mkdir/rm 에 사용한다.
# 불변 digest로 고정해 재현 가능하게 한다(떠다니는 태그는 cattle 재구축을 깨뜨린다).
# ⚠️ 이 자리에 "arm64 digest로 고정해 amd64를 조용히 끌어오는 일이 없게 한다"고 적혀 있었으나 **거짓**이었다:
#    이 digest는 amd64를 포함한 9플랫폼 인덱스다(실측 2026-08-11 — amd64·arm64·arm/v5·v6·v7·386·
#    ppc64le·riscv64·s390x). 노드 아키텍처를 따라가는 것이 맞고, NUC(amd64) 이전에 필요한 성질이다.
#    arch를 실제로 고정하려면 자식 manifest digest를 써야 하는데 그럴 이유가 없다.
export LOCAL_PATH_HELPER_IMAGE="busybox:1.38@sha256:fd8d9aa63ba2f0982b5304e1ee8d3b90a210bc1ffb5314d980eb6962f1a9715d"

# ⚠️ VM 사이징(`ORB_MEMORY_MIB`/`ORB_CPU`)은 제거됐다 — 베어메탈에는 VM이 없다.
#    그 두 값이 **조용히 강제하던 것**이 있었으니 기록해 둔다:
#      · `ORB_CPU=6`이 클러스터가 보는 논리 코어 수의 사실상 유일한 상한이었다. NUC는 **14코어**이고
#        `GOMAXPROCS`는 레포 어디에도 핀돼 있지 않다 → Go 프로세스 RSS 기준선이 조용히 달라진다.
#        핀할지 원장을 재기준선할지는 **미결정(D-e)**. 이 주석이 그 사실의 유일한 흔적이다.
#      · `ORB_MEMORY_MIB=12288`이 원장 meta `VM_ALLOCATABLE_MIB`의 물리적 근거였다. 그 meta는
#        이름과 달리 capacity 값이고 실제 allocatable(10744 MiB)과 1544 MiB 어긋나 있었다 —
#        NUC 재기준선 때 이름부터 바로잡을 것(`docs/memory-ledger.md:72`).

# ── NUC 베어메탈 호스트 좌표 (owner 확정 D-a/D-b) ──────────────────────────────────────────
# 노드 InternalIP. `wlo1`(WiFi)의 **DHCP 예약** 주소다.
# ⚠️ 라우터에 MAC `d4:94:a9:26:95:3a` 예약이 걸려 있어야 한다. 예약 없이 임대가 바뀌면 k3s가 이 주소를
#    못 잡아 **기동에 실패한다** — 조용히 다른 IP로 표류하는 것보다 낫다. netpol의 노드 서브넷 allow
#    6곳이 이 값의 /24를 전제하므로(platform/**), 표류하면 워크로드가 apiserver를 잃는다.
# ⚠️ 유선 `enp86s0`은 현재 NO-CARRIER다. 케이블을 꽂으면 기본 경로가 바뀔 수 있는데, 이 핀이 있으면
#    노드 IP는 움직이지 않는다(= 커밋 없이 발생하는 회귀 경로를 이 한 줄이 막는다).
export K3S_NODE_IP="192.168.117.15"

# k8s 노드명 (owner 확정 D-h, 2026-08-11). **설치 시점에만 정할 수 있다** — 사후 변경은 노드
# 재등록이라 hostPath PV의 nodeAffinity가 통째로 깨진다.
# ⚠️ 리눅스 hostname(`homelab`)을 쓰지 않는다. `homelab`은 이미 **세 가지**를 뜻한다:
#    리눅스 hostname · tailnet의 traefik-ts 프록시 디바이스(100.120.85.39) · 이 레포 이름.
#    네 번째 뜻을 더하면 "homelab이 unhealthy"라는 문장이 무엇을 가리키는지 알 수 없게 된다
#    (이 이전에서 `--tls-san`이 정확히 그 충돌로 틀릴 뻔했다).
# ⚠️ `k3s`인 이유: 반입 데이터가 옛 클러스터(노드명 `k3s`)의 hostPath 디렉토리이고, 복원 중
#    PV를 손으로 써야 할 때 옛 모양이 그대로 떨어진다 — **되돌리기 비싼 방향을 열어 둔다.**
#    (반입물에 PV 매니페스트는 없다 — 실측. 그래서 이 값은 강제가 아니라 선택이었다.)
export K3S_NODE_NAME="k3s"

# apiserver serving cert의 **추가** SAN(공백 구분). k3s가 기본으로 넣는 것(127.0.0.1 · localhost ·
# 노드 hostname · kubernetes.default.svc …)에 더해진다.
# ⚠️ **설치 시점에만 정할 수 있다** — 사후 추가는 serving cert 삭제 후 재생성을 요구한다.
# ⚠️ tailnet 이름 `homelab`을 여기 넣지 않는다. 그건 이 노드가 아니라 tailscale operator가 만드는
#    **traefik-ts 프록시 디바이스**의 이름이다(platform/tailscale/prod/traefik-ingress.yaml:12,
#    라이브 100.120.85.39). 이 노드의 tailnet 이름은 `nuc-15-pro`다.
#    (리눅스 hostname이 `homelab`이라 k3s가 그걸 자동으로 SAN에 넣는 것과는 별개다.)
export K3S_TLS_SANS="192.168.117.15 100.109.208.81 nuc-15-pro nuc-15-pro.tailcf1ac6.ts.net"

# ── 호스트 설정 계층 (host-config/) SSOT ───────────────────────────────────────────────────
# 아래 두 값은 `host-config/` 트리의 리터럴과 **정합해야** 한다. 트리 파일은 렌더링하지 않는다
# (실파일이라야 `diff`가 곧 리뷰다) — 대신 test_03-host-config.bats가 여기와 트리를 대조한다.

# 호스트 타임존. `host-preflight.sh`가 이 값을 기대하고, `host-config.sh --apply`가 이 값을 건다.
# ⚠️ CronJob 스케줄 **전부**의 전제다. Etc/UTC로 두면 모든 CronJob이 9시간 밀린다.
#    (`docs/traps-detail.md`의 "CronJob k3s VM TZ(Asia/Seoul)")
export HOST_TIMEZONE="Asia/Seoul"

# 노드 자신의 이름해석 업스트림 = LAN 게이트웨이(라우터). **클러스터 독립**이어야 한다.
# ⚠️ 실측 2026-08-11: 라우터는 AdGuard를 업스트림으로 쓰지 **않는다**(`dig @192.168.117.1
#    files.home.ukyi.app` → 빈 응답 / `github.com` → 정상 답). 즉 §2.4 교착의 탈출구가 실재한다.
#    이 값이 클러스터 안을 가리키는 순간 콜드스타트 교착이 되돌아온다.
export HOST_UPSTREAM_DNS="192.168.117.1"

# 노드 로컬 스토리지 경로.
# internal: 노드 내장 디스크 위, `host-config.sh --apply`가 생성.
export INTERNAL_STORAGE_PATH="/var/lib/rancher/k3s-storage/internal"

# ── bulk-ssd 티어 ──────────────────────────────────────────────────────────────────────────
# bulk 노드 경로. **마운트포인트여야 한다** — 이 값이 그냥 디렉토리이면 bulk가 부트 디스크에
# 조용히 놓이고, 그건 cattle 재구축·재포맷에서 유실되는 상태다. `bulk-gate-probe.sh`가 강제한다.
#
# ⚠️ 경로를 **두 국면에 걸쳐 불변**으로 둔다(nuc-port-g2.md B7 권고):
#     국면 A (D4 한시)  : 루트 LV 위 디렉토리를 여기에 **bind 마운트**
#     국면 B (PONR 3 후): 실제 2TB M.2를 여기에 마운트
#    경로가 안 바뀌므로 PONR 3에서 PV hostPath 재작성도, platform 매니페스트 재수정도 없다.
#    두 국면의 구별은 경로가 아니라 **디바이스 정체성**으로 한다 — 루트와 같은 디바이스면 국면 A다.
export BULK_STORAGE_PATH="/mnt/bulk"

# 국면 A(D4 한시 운용)의 만료일 `YYYY-MM-DD`. **owner만 정할 수 있다**(G4~G10 소요 추정).
# ⚠️ **비어 있으면 국면 A 진입이 거부된다**(fail-closed). 날짜를 지어내지 않기 위한 설계다 —
#    `BULK_TEMPORARY_ALLOWED=1`만으로는 부족하고 이 값이 함께 있어야 한다.
# ⚠️ 만료 후에도 **기동은 막지 않는다**. 요란하게 짖기만 한다(선례: check-credential-expiry.sh) —
#    만료 하나로 클러스터가 안 뜨는 것은 이 창의 목적이 아니다.
# ⚠️ 이 값이 **비어 있지 않으면 `dr-drill.sh`가 실행을 거부한다.** 국면 A 동안 bulk는 파괴 대상과
#    같은 디스크에 있어서 드릴이 사용자 데이터를 실제로 지운다. PONR 3에서 이 값을 비우는 것이
#    국면 B 진입의 선언이다.
# ✅ 국면 A 진입 (owner 확정 2026-08-11). NUC의 `/mnt/bulk`는 루트 LV
#    `/var/lib/rancher/k3s-storage/bulk`의 **bind 마운트**다(실측 SOURCE:
#    `/dev/mapper/ubuntu--vg-ubuntu--lv[/var/lib/rancher/k3s-storage/bulk]`).
#    이 값이 채워져 있는 동안 `dr-drill.sh`는 실행을 거부한다. 국면 B에서 비울 것.
export BULK_MIGRATION_WINDOW_UNTIL="2026-09-30"
